{
  "expo": {
    "name": "Wary",
    "slug": "lens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brendanmccormack.lens",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      },
      "appleTeamId": "WH3N6PVX8Y",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.brendanmccormack.lens",
          "group.com.brendanmccormack.lens"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "./plugins/withShareExtensionName",
        {
          "displayName": "Wary"
        }
      ],
      [
        "./plugins/withDeploymentTarget",
        {
          "target": "16.4"
        }
      ],
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Wary uses the camera to look at things you want checked — like a pop-up, a letter or a QR code — only while the scanner is open.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wary needs access to the screenshot or photo you choose so it can explain it."
        }
      ],
      [
        "expo-share-extension",
        {
          "activationRules": [
            {
              "type": "text"
            },
            {
              "type": "url",
              "max": 1
            },
            {
              "type": "image",
              "max": 1
            }
          ],
          "backgroundColor": {
            "red": 10,
            "green": 11,
            "blue": 10,
            "alpha": 1
          },
          "height": 720,
          "excludedPackages": [
            "expo-dev-client",
            "expo-splash-screen",
            "expo-updates",
            "expo-router",
            "expo-camera",
            "expo-image-picker",
            "expo-clipboard",
            "expo-linking"
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "scheme": "wary",
    "backgroundColor": "#0A0B0A",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "631297ec-9d5f-4839-90ae-412875861b3c"
      },
      "appleApplicationGroup": "group.com.brendanmccormack.lens"
    },
    "owner": "brendanbjhvh",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/631297ec-9d5f-4839-90ae-412875861b3c"
    }
  }
}
